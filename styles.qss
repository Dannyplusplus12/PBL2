/* ================= GLOBAL ================= */
* {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    outline: none;
}
QMainWindow, QDialog {
    background: #f1f5f9;
}
QWidget#DashboardPage, QWidget#BorrowReturnPage, QWidget#ManagementPage {
    background: #f1f5f9;
}

/* ================= TITLE ================= */
QLabel#pageTitle {
    font-size: 20px;
    font-weight: 700;
    color: #0f172a;
    padding: 4px 0 2px 0;
}

/* ================= SIDEBAR (bên phải) ================= */
QListWidget#navList {
    background: #ffffff;
    border: none;
    border-left: 1px solid #e2e8f0;
    padding: 14px 4px;
    font-size: 15px;
}
QListWidget#navList::item {
    color: #475569;
    padding: 14px 18px;
    margin: 3px 8px;
    border-radius: 8px;
}
QListWidget#navList::item:hover {
    background: #f1f5f9;
    color: #0f172a;
}
QListWidget#navList::item:selected {
    background: #2563eb;
    color: #ffffff;
}


/* ================= CARDS (tổng quan) ================= */
QFrame#cardBooks, QFrame#cardCustomers,
QFrame#cardBorrowing, QFrame#cardOverdue {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}
QFrame#cardOverdue {
    border-left: 5px solid #ef4444;
}
QFrame#cardOverdue:hover {
    background: #fef2f2;
}
QLabel#cardBooksTitle, QLabel#cardCustomersTitle,
QLabel#cardBorrowingTitle, QLabel#cardOverdueTitle {
    color: #64748b;
    font-size: 13px;
}
QLabel#cardBooksValue, QLabel#cardCustomersValue,
QLabel#cardBorrowingValue, QLabel#cardOverdueValue {
    color: #0f172a;
    font-size: 28px;
    font-weight: 700;
}
QLabel#cardOverdueValue {
    color: #ef4444;
}

/* ================= TABLES ================= */
QTableWidget {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #eef2f7;
    selection-background-color: #dbeafe;
    selection-color: #0f172a;
}
QHeaderView::section {
    background: #f8fafc;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    font-weight: 600;
    color: #334155;
}
QTableWidget::item {
    padding: 6px;
}

/* ================= LISTS ================= */
QListWidget {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}
QListWidget::item {
    padding: 10px 12px;
    border-bottom: 1px solid #f1f5f9;
}
QListWidget::item:selected {
    background: #dbeafe;
    color: #0f172a;
}

/* ================= INPUTS ================= */
QLineEdit, QSpinBox, QComboBox {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 9px;
    color: #0f172a;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #2563eb;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}

/* ================= BUTTONS ================= */
QPushButton {
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font-weight: 500;
}
QPushButton:hover { background: #1d4ed8; }
QPushButton:pressed { background: #1e40af; }
QPushButton:disabled { background: #cbd5e1; color: #f1f5f9; }

/* nút xóa -> đỏ */
QPushButton[objectName$="DeleteBtn"] {
    background: #ef4444;
}
QPushButton[objectName$="DeleteBtn"]:hover {
    background: #dc2626;
}

/* nút phụ -> nền trắng viền xanh */
QPushButton#editBtn, QPushButton#toggleLockBtn, QPushButton#cancelBtn,
QPushButton#editBookBtn, QPushButton#editAuthorBtn, QPushButton#editGenreBtn,
QPushButton#checkBtn {
    background: #ffffff;
    color: #2563eb;
    border: 1px solid #2563eb;
}
QPushButton#editBtn:hover, QPushButton#toggleLockBtn:hover, QPushButton#cancelBtn:hover,
QPushButton#editBookBtn:hover, QPushButton#editAuthorBtn:hover, QPushButton#editGenreBtn:hover,
QPushButton#checkBtn:hover {
    background: #eff6ff;
}


/* ================= TAB ================= */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #ffffff;
}
QTabBar::tab {
    background: transparent;
    padding: 10px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    color: #64748b;
    font-weight: 500;
}
QTabBar::tab:selected {
    color: #2563eb;
    border-bottom: 2px solid #2563eb;
}
QTabBar::tab:hover {
    color: #0f172a;
}

/* ================= SECTION TITLE ================= */
QLabel#sectionTitle {
    font-size: 15px;
    font-weight: 700;
    color: #334155;
}
